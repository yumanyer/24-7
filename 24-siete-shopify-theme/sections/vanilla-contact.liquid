<div class="contact-shell">
  <main class="contact-main">
    <section class="hero">
      <div class="hero-copy">
        <span class="hero-tag">{{ section.settings.hero_tag }}</span>
        <h1>{{ section.settings.hero_title | newline_to_br }}</h1>
      </div>
      <div class="hero-caption">
        <p>{{ section.settings.hero_caption }}</p>
      </div>
    </section>

    <section class="support-cards">
      <article class="support-card">
        <div class="card-icon">🚚</div>
        <div class="card-title">{{ section.settings.card1_title }}</div>
        <p>{{ section.settings.card1_text }}</p>
        <div class="card-footer">
          <span>{{ section.settings.card1_dept }}</span>
          <a href="#">{{ section.settings.card1_link }}</a>
        </div>
      </article>
      <article class="support-card">
        <div class="card-icon">🖥️</div>
        <div class="card-title">{{ section.settings.card2_title }}</div>
        <p>{{ section.settings.card2_text }}</p>
        <div class="card-footer">
          <span>{{ section.settings.card2_dept }}</span>
          <a href="#">{{ section.settings.card2_link }}</a>
        </div>
      </article>
      <article class="support-card">
        <div class="card-icon">🛡️</div>
        <div class="card-title">{{ section.settings.card3_title }}</div>
        <p>{{ section.settings.card3_text }}</p>
        <div class="card-footer">
          <span>{{ section.settings.card3_dept }}</span>
          <a href="#">{{ section.settings.card3_link }}</a>
        </div>
      </article>
    </section>

    <section class="info-grid">
      <div class="network-panel">
        <div class="panel-title">{{ section.settings.network_title }}</div>
        <div class="network-link">
          <span class="network-label">{{ section.settings.network1_label }}</span>
          <span class="network-value">{{ section.settings.network1_value }}</span>
          <span class="network-action">→</span>
        </div>
        <div class="network-link">
          <span class="network-label">{{ section.settings.network2_label }}</span>
          <span class="network-value">{{ section.settings.network2_value }}</span>
          <span class="network-action">→</span>
        </div>
        <div class="network-link">
          <span class="network-label">{{ section.settings.network3_label }}</span>
          <span class="network-value">{{ section.settings.network3_value }}</span>
          <span class="network-action">→</span>
        </div>
        <p class="network-meta">{{ section.settings.network_meta }}</p>
      </div>

      <div class="hub-panel">
        <div class="panel-title">{{ section.settings.hub_title }}</div>
        <div class="hub-item">
          <span class="hub-label">{{ section.settings.hub1_label }}</span>
          <span class="hub-text">{{ section.settings.hub1_text }}</span>
        </div>
        <div class="hub-item">
          <span class="hub-label">{{ section.settings.hub2_label }}</span>
          <span class="hub-text">{{ section.settings.hub2_text }}</span>
        </div>
        <div class="hub-item">
          <span class="hub-label">{{ section.settings.hub3_label }}</span>
          <span class="hub-text">{{ section.settings.hub3_text }}</span>
        </div>
        <div class="hub-item">
          <span class="hub-label">{{ section.settings.hub4_label }}</span>
          <span class="hub-text">{{ section.settings.hub4_text }}</span>
        </div>
        <div class="hub-media">
          <div class="media-label">{{ section.settings.media_label }}</div>
          {% if section.settings.media_image != blank %}
            <div class="media-image" style="background-image: url('{{ section.settings.media_image | image_url }}')"></div>
          {% else %}
            <div class="media-image"></div>
          {% endif %}
        </div>
      </div>
    </section>
  </main>

  <footer class="contact-footer">
    <div class="footer-brand">{{ shop.name }}</div>
    <div class="footer-links">
      <a href="{{ routes.root_url }}#manifesto">{{ section.settings.footer_link1 }}</a>
      <a href="{{ routes.collections_url }}">{{ section.settings.footer_link2 }}</a>
      <a href="#">{{ section.settings.footer_link3 }}</a>
      <a href="#">{{ section.settings.footer_link4 }}</a>
    </div>
    <div class="footer-copy">{{ section.settings.footer_copy }}</div>
  </footer>
</div>

