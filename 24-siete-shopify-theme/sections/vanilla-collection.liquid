{{ 'vanilla-collection.css' | asset_url | stylesheet_tag }}

<div class="page-shell">
  <main class="collection-page">
    <section class="collection-hero">
      <div class="collections-copy">
        <div class="hero-title">
          <span>{{ section.settings.hero_main_title }}</span>
          <span class="subline">{{ section.settings.hero_subline }}</span>
        </div>
        <div class="hero-text">
          <p>{{ section.settings.hero_text1 }}</p>
          <p>{{ section.settings.hero_text2 }}</p>
          <p>{{ section.settings.hero_text3 }}</p>
        </div>
      </div>

      <div class="collection-filters" role="tablist" aria-label="{{ section.settings.filters_label }}">
        {%- assign current_tag = collection.current_tag | default: '' -%}
        {%- assign all_tags = collection.all_tags -%}
        
        <a class="filter pill {% if current_tag == '' %}active{% endif %}" 
           href="{{ collection.url }}" 
           role="tab" 
           aria-selected="{% if current_tag == '' %}true{% else %}false{% endif %}">
          {{ section.settings.filter_all }}
        </a>
        
        {%- if all_tags.size > 0 -%}
          {%- for tag in all_tags limit: 10 -%}
            {%- assign tag_handle = tag | handleize -%}
            <a class="filter pill {% if current_tag == tag_handle %}active{% endif %}" 
               href="{{ collection.url }}/{{ tag_handle }}" 
               role="tab" 
               aria-selected="{% if current_tag == tag_handle %}true{% else %}false{% endif %}">
              {{ tag }}
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Fallback static filters if no tags exist {%- endcomment -%}
          <a class="filter pill {% if current_tag == 'remeras' %}active{% endif %}" 
             href="{{ collection.url }}/remeras" 
             role="tab" 
             aria-selected="{% if current_tag == 'remeras' %}true{% else %}false{% endif %}">
            {{ section.settings.filter_remeras }}
          </a>
          <a class="filter pill {% if current_tag == 'buzos' %}active{% endif %}" 
             href="{{ collection.url }}/buzos" 
             role="tab" 
             aria-selected="{% if current_tag == 'buzos' %}true{% else %}false{% endif %}">
            {{ section.settings.filter_buzos }}
          </a>
          <a class="filter pill {% if current_tag == 'accesorios' %}active{% endif %}" 
             href="{{ collection.url }}/accesorios" 
             role="tab" 
             aria-selected="{% if current_tag == 'accesorios' %}true{% else %}false{% endif %}">
            {{ section.settings.filter_accesorios }}
          </a>
        {%- endif -%}
      </div>
    </section>

    <section class="catalogue-grid" id="ProductGrid">
      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- if collection.products.size == 0 -%}
          <div class="catalogue-card">
            <p>{{ 'sections.collection_template.empty' | t }}</p>
          </div>
        {%- else -%}
          {%- for product in collection.products -%}
            {% render 'vanilla-collection-product-card', card_product: product %}
          {%- endfor -%}
        {%- endif -%}
      {%- endpaginate -%}
    </section>

    <section class="load-more-section">
      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- if paginate.next -%}
          <a class="load-more" href="{{ paginate.next.url }}">{{ section.settings.load_more_text }}</a>
        {%- else -%}
          <button class="load-more" disabled>{{ section.settings.load_more_text }}</button>
        {%- endif -%}
      {%- endpaginate -%}
      <div class="divider"></div>
    </section>
  </main>

  <footer class="collection-footer">
    <div class="footer-links">
      <span class="footer-title">{{ shop.name }}</span>
      <div class="footer-nav">
        <a href="{{ routes.policies_url }}#terms">{{ 'general.footer.terms' | t }}</a>
        <a href="{{ routes.policies_url }}#shipping">{{ 'general.footer.shipping' | t }}</a>
        <a href="{{ routes.contact_url }}">{{ 'general.footer.contact' | t }}</a>
        <a href="{{ routes.root_url }}#archive">{{ 'general.footer.archive' | t }}</a>
      </div>
    </div>
    <div class="footer-meta">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} INDUSTRIAL [SYSTEM_READY]</span>
    </div>
  </footer>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  // Filter pill buttons - visual state is handled by server-side rendering (active class)
  // No additional JS needed since they're actual links
  
  // Load more button interaction
  const loadMoreBtn = document.querySelector('.load-more');
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', function (e) {
      if (this.disabled) {
        e.preventDefault();
      }
    });
  }
});
</script>

{% schema %}
{
  "name": "Vanilla Collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "hero_main_title",
      "label": "Hero Main Title",
      "default": "INDUSTRIAL"
    },
    {
      "type": "text",
      "id": "hero_subline",
      "label": "Hero Subline",
      "default": "CATALOGUE 024"
    },
    {
      "type": "text",
      "id": "hero_text1",
      "label": "Hero Text Line 1",
      "default": "High-performance garments engineered for urban density."
    },
    {
      "type": "text",
      "id": "hero_text2",
      "label": "Hero Text Line 2",
      "default": "Machined construction, obsidian palettes, architectural"
    },
    {
      "type": "text",
      "id": "hero_text3",
      "label": "Hero Text Line 3",
      "default": "silhouettes."
    },
    {
      "type": "text",
      "id": "filters_label",
      "label": "Filters ARIA Label",
      "default": "Filtros de colección"
    },
    {
      "type": "text",
      "id": "filter_all",
      "label": "Filter All Label",
      "default": "ALL_UNITS"
    },
    {
      "type": "text",
      "id": "filter_remeras",
      "label": "Filter Remeras Label",
      "default": "REMERAS"
    },
    {
      "type": "text",
      "id": "filter_buzos",
      "label": "Filter Buzos Label",
      "default": "BUZOS"
    },
    {
      "type": "text",
      "id": "filter_accesorios",
      "label": "Filter Accesorios Label",
      "default": "ACCESORIOS"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 6,
      "max": 36,
      "step": 3,
      "default": 9
    },
    {
      "type": "text",
      "id": "load_more_text",
      "label": "Load More Text",
      "default": "LOAD_NEXT_BATCH"
    }
  ],
  "presets": [
    {
      "name": "Vanilla Collection"
    }
  ]
}
{% endschema %}