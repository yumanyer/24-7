{{ 'vanilla-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign variant_picker_block = section.blocks | where: 'type', 'variant_picker' | first
  assign buy_buttons_block = section.blocks | where: 'type', 'buy_buttons' | first
  assign product_form_id = 'product-form-' | append: section.id

  assign show_dynamic_checkout = false
  if buy_buttons_block != blank and buy_buttons_block.settings.show_dynamic_checkout
    assign show_dynamic_checkout = true
  endif

  assign gift_card_recipient_feature_active = false
-%}

<div
  class="vanilla-product-page"
  data-section-id="{{ section.id }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-currency-code="{{ cart.currency.iso_code | default: shop.currency | escape }}"
>
  <!-- PRODUCT HERO SECTION -->
  <section class="product-hero">
    <div class="hero-container">
      <!-- Product Image -->
      <div class="product-image-container">
        {% if product.media.size > 0 %}
          <ul class="product-media-list" role="list">
            {%- for media in product.media -%}
              <li
                class="product-media-item{% if forloop.first %} is-active{% endif %}"
                data-media-id="{{ media.id }}"
                data-media-type="{{ media.media_type }}"
              >
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    <img
                      class="product-image"
                      src="{{ media | image_url: width: 1200 }}"
                      alt="{{ media.alt | escape }}"
                      width="{{ media.width }}"
                      height="{{ media.height }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    >
                  {%- when 'video' -%}
                    <video class="product-image product-media-video" controls playsinline preload="metadata">
                      <source src="{{ media | video_url }}" type="video/mp4">
                    </video>
                  {%- when 'external_video' -%}
                    <video class="product-image product-media-video" controls playsinline preload="metadata">
                      <source src="{{ media | external_video_url }}" type="video/mp4">
                    </video>
                  {%- when 'model' -%}
                    <model-viewer
                      class="product-image"
                      src="{{ media | model_viewer_url }}"
                      alt="{{ media.alt | escape }}"
                      auto-rotate
                      camera-controls
                    ></model-viewer>
                  {%- else -%}
                    <img
                      class="product-image"
                      src="{{ media.preview_image | image_url: width: 1200 }}"
                      alt="{{ media.alt | escape }}"
                      width="{{ media.preview_image.width }}"
                      height="{{ media.preview_image.height }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    >
                {%- endcase -%}
              </li>
            {%- endfor -%}
          </ul>
        {% else %}
          <img class="product-image" src="{{ 'product-placeholder.svg' | asset_url }}" alt="{{ product.title | escape }}">
        {% endif %}
      </div>

      <!-- Product Details -->
      <div class="product-details">
        <div class="product-badge">{{ section.settings.badge_text }}</div>
        <h1 class="product-title">{{ product.title }}</h1>

        <div class="product-price-group">
          <span
            class="product-compare-price"
            id="ComparePrice-{{ section.id }}"
            {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
          >{{ current_variant.compare_at_price | money }}</span>
          <p class="product-price" id="price-{{ section.id }}">
            {{ current_variant.price | default: product.price | money_with_currency }}
          </p>
        </div>

        <!-- Product Description -->
        <div class="product-description">
          {{ product.description }}
          {% if product.metafields.custom.features != blank %}
            <ul class="product-features">
              {% for feature in product.metafields.custom.features %}
                <li>{{ feature }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>

        {% unless product.has_only_default_variant %}
          <!-- Size / Variant Selection -->
          <div class="size-section">
            {% render 'product-variant-picker',
              product: product,
              block: variant_picker_block,
              product_form_id: product_form_id
            %}
          </div>
        {% endunless %}

        <!-- Buy Button -->
        {% render 'buy-buttons',
          block: buy_buttons_block,
          product: product,
          product_form_id: product_form_id,
          section_id: section.id,
          button_label: 'COMPRAR →',
          show_pickup_availability: false,
          show_dynamic_checkout: show_dynamic_checkout,
          gift_card_recipient_feature_active: gift_card_recipient_feature_active
        %}

        <!-- Shipping & Authenticity -->
        <div class="product-info-row">
          <div class="info-item">
            <svg class="info-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"/>
            </svg>
            <span>{{ section.settings.shipping_text }}</span>
          </div>
        </div>
        <div class="product-info-row">
          <div class="info-item">
            <svg class="info-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M9 11l3 3L22 4"/>
              <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
            </svg>
            <span>{{ section.settings.authenticity_text }}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE CRAFT SECTION -->
  <section class="craft-section">
    <div class="craft-container">
      <div class="craft-content">
        <h2 class="craft-title">{{ section.settings.craft_title }}</h2>
        <p class="craft-description">{{ section.settings.craft_description }}</p>
        <div class="craft-details">
          <p><strong>{{ section.settings.craft_location_label }}:</strong> {{ section.settings.craft_location }}</p>
          <p><strong>{{ section.settings.craft_method_label }}:</strong> {{ section.settings.craft_method }}</p>
        </div>
      </div>
      <div class="craft-image">
        {% if section.settings.craft_image != blank %}
          <img src="{{ section.settings.craft_image | image_url: width: 800 }}" alt="{{ section.settings.craft_image_alt }}" width="{{ section.settings.craft_image.width }}" height="{{ section.settings.craft_image.height }}" loading="lazy">
        {% else %}
          <img src="{{ 'atelier-placeholder.jpg' | asset_url }}" alt="Atelier" loading="lazy">
        {% endif %}
      </div>
    </div>
  </section>

  <!-- ACCESSORIES SECTION -->
  {% if collections[section.settings.accessories_collection] != blank %}
  <section class="accessories-section">
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.accessories_title }}</h2>
      <a href="{{ collections[section.settings.accessories_collection].url }}" class="view-all">{{ section.settings.view_all_text }}</a>
    </div>
    <div class="accessories-grid">
      {% for accessory in collections[section.settings.accessories_collection].products limit: 3 %}
        <a href="{{ accessory.url }}" class="product-card">
          <div class="product-card-image">
            {% if accessory.featured_image %}
              <img src="{{ accessory.featured_image | image_url: width: 400 }}" alt="{{ accessory.featured_image.alt | escape }}">
            {% else %}
              <img src="{{ 'product-placeholder.svg' | asset_url }}" alt="{{ accessory.title }}">
            {% endif %}
          </div>
          <h3 class="product-card-title">{{ accessory.title }}</h3>
          <p class="product-card-price">{{ accessory.price | money }}</p>
        </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- BRAND LOGO SECTION -->
  <section class="brand-section">
    <div class="brand-logo">
      {% if section.settings.brand_logo != blank %}
        <img src="{{ section.settings.brand_logo | image_url: width: 300 }}" alt="{{ section.settings.brand_logo_alt }}">
      {% else %}
        <img src="{{ 'brand-logo.svg' | asset_url }}" alt="Academia Purística">
      {% endif %}
    </div>
  </section>
</div>

<!-- Variant data (real) used to update price/media/button on selection -->
<script type="application/json" id="VanillaProductVariants-{{ section.id }}">
  {{ product.variants | json }}
</script>

<!-- Static bridge element so Dawn's product-form can drive the vanilla cart drawer -->
<cart-drawer class="vanilla-cart-drawer-bridge" hidden></cart-drawer>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'vanilla-product.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Vanilla Product",
  "tag": "section",
  "blocks": [
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_types",
          "label": "Type",
          "options": [
            {
              "value": "pills",
              "label": "Circle buttons"
            },
            {
              "value": "dropdown",
              "label": "Dropdown"
            },
            {
              "value": "swatches",
              "label": "Swatches"
            },
            {
              "value": "swatch_dropdown",
              "label": "Swatches dropdown"
            }
          ],
          "default": "pills"
        },
        {
          "type": "text",
          "id": "custom_labels",
          "label": "Custom label",
          "info": "Use [name], [name_lowercase], [name_uppercase], [count] or [selected] as placeholders.",
          "default": "[name]"
        },
        {
          "type": "header",
          "content": "Swatches"
        },
        {
          "type": "text",
          "id": "swatches_custom_colors_list",
          "label": "Custom swatches colors",
          "info": "Comma separated CSS colors, e.g. #fff, rgb(255,0,0)."
        },
        {
          "type": "select",
          "id": "swatches_custom_colors",
          "label": "Custom swatches colors from",
          "options": [
            {
              "value": "disabled",
              "label": "Disabled"
            },
            {
              "value": "enabled",
              "label": "Variant image"
            },
            {
              "value": "image_alt",
              "label": "Variant image alt"
            },
            {
              "value": "custom",
              "label": "Custom colors list"
            }
          ],
          "default": "enabled"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout buttons",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "uppercase_text",
          "label": "Uppercase text",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "enable_custom_color",
          "label": "Use custom button color",
          "default": false
        },
        {
          "type": "color",
          "id": "custom_color",
          "label": "Custom color",
          "default": "#000000"
        },
        {
          "type": "checkbox",
          "id": "skip_cart",
          "label": "Skip cart",
          "default": false
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "Margin top",
          "min": 0,
          "max": 200,
          "step": 5,
          "unit": "px",
          "default": 10
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Margin bottom",
          "min": 0,
          "max": 200,
          "step": 5,
          "unit": "px",
          "default": 10
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "EDITION LIMITADA"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping Text",
      "default": "WORLDWIDE SHIPPING 2-3 DAYS"
    },
    {
      "type": "text",
      "id": "authenticity_text",
      "label": "Authenticity Text",
      "default": "CERTIFICATE OF AUTHENTICITY INCLUDED"
    },
    {
      "type": "text",
      "id": "craft_title",
      "label": "Craft Title",
      "default": "THE CRAFT."
    },
    {
      "type": "textarea",
      "id": "craft_description",
      "label": "Craft Description",
      "default": "Our process rejects mass production. Each 'Obsidian Core' garment undergoes a 12-hour cutting cycle by hand and is finished with archival-grade pigments. Floors, this isn't just clothing. It's a permanent installation."
    },
    {
      "type": "text",
      "id": "craft_location_label",
      "label": "Craft Location Label",
      "default": "LOCATION"
    },
    {
      "type": "text",
      "id": "craft_location",
      "label": "Craft Location",
      "default": "BUENOS AIRES ATELIER"
    },
    {
      "type": "text",
      "id": "craft_method_label",
      "label": "Craft Method Label",
      "default": "METHOD"
    },
    {
      "type": "text",
      "id": "craft_method",
      "label": "Craft Method",
      "default": "HAND-APPLIED OXIDATION"
    },
    {
      "type": "image_picker",
      "id": "craft_image",
      "label": "Craft Image"
    },
    {
      "type": "text",
      "id": "craft_image_alt",
      "label": "Craft Image Alt",
      "default": "Atelier"
    },
    {
      "type": "text",
      "id": "accessories_title",
      "label": "Accessories Title",
      "default": "ACCESSORIES / RELEVANT"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "VIEW ALL"
    },
    {
      "type": "collection",
      "id": "accessories_collection",
      "label": "Accessories Collection"
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Brand Logo"
    },
    {
      "type": "text",
      "id": "brand_logo_alt",
      "label": "Brand Logo Alt",
      "default": "Academia Purística"
    }
  ],
  "presets": [
    {
      "name": "Vanilla Product"
    }
  ]
}
{% endschema %}