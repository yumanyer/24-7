    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Brand Logo"
    },
    {
      "type": "text",
      "id": "brand_logo_alt",
      "label": "Brand Logo Alt",
      "default": "Academia Purística"
    }
  ],
  "presets": [
    {
      "name": "Vanilla Product"
    }
  ]
}
{% endschema %}