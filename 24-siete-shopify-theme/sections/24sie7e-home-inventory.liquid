<section class="sie7e24-home sie7e24-home-inventory">
  <div class="sie7e24-home__inner">
    <div class="sie7e24-home-inventory__header">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="sie7e24-home-inventory__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="sie7e24-home-inventory__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_filters and section.blocks.size > 0 -%}
        <nav class="sie7e24-home-inventory__filters" aria-label="{{ section.settings.filters_label | escape }}">
          {%- for block in section.blocks -%}
            {%- assign filter_collection = block.settings.collection -%}
            {%- if filter_collection != blank -%}
              <a
                class="sie7e24-home-inventory__filter"
                href="{{ filter_collection.url }}"
                aria-current="{% if collection.handle == filter_collection.handle %}true{% else %}false{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label | default: filter_collection.title | escape }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>

    {%- if section.settings.collection != blank -%}
      {%- assign home_collection = section.settings.collection -%}
      <div class="sie7e24-home-inventory__grid" role="list">
        {%- for card_product in home_collection.products limit: section.settings.products_to_show -%}
          <div role="listitem">
            {% render 'sie7e24-home-product-card', card_product: card_product %}
          </div>
        {%- else -%}
          <p>{{ 'sections.featured_collection.no_products' | t }}</p>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="sie7e24-home-inventory__grid" role="list">
        {%- for i in (1..3) -%}
          <div role="listitem" class="sie7e24-home-product-card">
            <div class="sie7e24-home-product-card__figure">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="sie7e24-home-product-card__details">
              <div><h3 class="sie7e24-home-product-card__title">PRODUCT {{ i }}</h3></div>
              <span class="sie7e24-home-product-card__price">—</span>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "24/SIE7E inventory",
  "tag": "section",
  "class": "section-sie7e24-home-inventory",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "CURRENT INVENTORY"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Series de producción limitada. Una vez agotadas, el diseño entra en el archivo permanente y no vuelve a circular.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección de productos"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Productos a mostrar",
      "min": 3,
      "max": 9,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Mostrar filtros de colección",
      "default": true
    },
    {
      "type": "text",
      "id": "filters_label",
      "label": "Etiqueta accesible de filtros",
      "default": "Categorías de producto"
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filtro de colección",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto del filtro"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección enlazada"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "24/SIE7E inventory",
      "blocks": [
        { "type": "filter", "settings": { "label": "BUZOS" } },
        { "type": "filter", "settings": { "label": "REMERAS" } },
        { "type": "filter", "settings": { "label": "ACCESORIOS" } }
      ]
    }
  ]
}
{% endschema %}
