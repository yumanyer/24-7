{%- liquid
  assign hero_video = section.settings.video
  assign hero_image = section.settings.image
  assign hero_mobile_image = section.settings.mobile_image
-%}

<section
  id="collection"
  class="hero-section sie7e24-home sie7e24-home-hero"
  style="--24-hero-height: {{ section.settings.hero_height }}px; --24-hero-height-mobile: {{ section.settings.mobile_hero_height }}px;"
>
  <div class="hero-background sie7e24-home-hero__media" aria-hidden="true">
    {%- if hero_video != blank -%}
      <video class="sie7e24-home-hero__video" autoplay muted loop playsinline preload="metadata"{% if hero_video.preview_image != blank %} poster="{{ hero_video.preview_image | image_url: width: 2000 }}"{% endif %}>
        {%- for source in hero_video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
    {%- elsif hero_image != blank -%}
      <img
        class="sie7e24-home-hero__image{% if hero_mobile_image != blank %} sie7e24-home-hero__image--desktop{% endif %}"
        srcset="
          {%- if hero_image.width >= 750 -%}{{ hero_image | image_url: width: 750 }} 750w,{%- endif -%}
          {%- if hero_image.width >= 1100 -%}{{ hero_image | image_url: width: 1100 }} 1100w,{%- endif -%}
          {%- if hero_image.width >= 1500 -%}{{ hero_image | image_url: width: 1500 }} 1500w,{%- endif -%}
          {%- if hero_image.width >= 2000 -%}{{ hero_image | image_url: width: 2000 }} 2000w,{%- endif -%}
          {{ hero_image | image_url }} {{ hero_image.width }}w
        "
        src="{{ hero_image | image_url: width: 2000 }}"
        sizes="100vw"
        width="{{ hero_image.width }}"
        height="{{ hero_image.height }}"
        alt=""
        loading="eager"
        style="object-position: {{ section.settings.image_position }};"
      >
      {%- if hero_mobile_image != blank -%}
        <img
          class="sie7e24-home-hero__image sie7e24-home-hero__image--mobile"
          srcset="
            {%- if hero_mobile_image.width >= 375 -%}{{ hero_mobile_image | image_url: width: 375 }} 375w,{%- endif -%}
            {%- if hero_mobile_image.width >= 750 -%}{{ hero_mobile_image | image_url: width: 750 }} 750w,{%- endif -%}
            {{ hero_mobile_image | image_url }} {{ hero_mobile_image.width }}w
          "
          src="{{ hero_mobile_image | image_url: width: 750 }}"
          sizes="100vw"
          width="{{ hero_mobile_image.width }}"
          height="{{ hero_mobile_image.height }}"
          alt=""
          loading="eager"
          style="object-position: {{ section.settings.mobile_image_position }};"
        >
      {%- endif -%}
    {%- else -%}
      <div class="sie7e24-home-hero__placeholder"></div>
    {%- endif -%}
  </div>
  <div class="hero-overlay sie7e24-home-hero__overlay" aria-hidden="true"></div>
  <div class="sie7e24-home-hero__grid" aria-hidden="true"></div>

  <div class="sie7e24-home__inner">
    <div class="hero-copy sie7e24-home-hero__content">
      {%- if section.settings.pill != blank -%}
        <span class="hero-pill sie7e24-home-hero__pill">{{ section.settings.pill | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="sie7e24-home-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.copy != blank -%}
        <div class="sie7e24-home-hero__copy rte">{{ section.settings.copy }}</div>
      {%- endif -%}

      <div class="hero-actions sie7e24-home-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a
            class="btn btn-primary button button--primary"
            {% if section.settings.primary_link != blank %}href="{{ section.settings.primary_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          >
            {{ section.settings.primary_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a
            class="btn btn-secondary button button--secondary"
            {% if section.settings.secondary_link != blank %}href="{{ section.settings.secondary_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          >
            {{ section.settings.secondary_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.show_scroll_hint -%}
    <div id="hero-scroll" class="hero-scroll sie7e24-home-hero__scroll" aria-hidden="true">
      <span>{{ section.settings.scroll_label | escape }}</span>
      <span class="scroll-line sie7e24-home-hero__scroll-line"></span>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "24/SIE7E hero",
  "tag": "section",
  "class": "section-sie7e24-home-hero",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video de fondo del hero",
      "info": "El video se reproduce automáticamente, sin sonido y en loop. Si queda vacío, se usa la imagen desktop."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagen de fondo mobile",
      "info": "Opcional. Si queda vacío se reutiliza la imagen desktop."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posición de imagen desktop",
      "default": "center",
      "options": [
        { "value": "top", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "bottom", "label": "Abajo" },
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Posición de imagen mobile",
      "default": "center",
      "options": [
        { "value": "top", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "bottom", "label": "Abajo" },
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ]
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Altura desktop",
      "min": 560,
      "max": 1100,
      "step": 20,
      "unit": "px",
      "default": 860
    },
    {
      "type": "range",
      "id": "mobile_hero_height",
      "label": "Altura mobile",
      "min": 480,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "text",
      "id": "pill",
      "label": "Etiqueta superior",
      "default": "DROP LIMITADO"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Título",
      "default": "PRENDAS\nINTERVENIDAS"
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Descripción",
      "default": "<p>Nuestra serie industrial fusiona procesos químicos con siluetas sobredimensionadas. Cada pieza es única, numerada y producida bajo demanda.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Texto CTA principal",
      "default": "VER COLECCIÓN"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Enlace CTA principal"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Texto CTA secundario",
      "default": "ARCHIVO 24/7"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Enlace CTA secundario"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Mostrar indicador de exploración",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "Texto del indicador",
      "default": "EXPLORAR MATERIAL"
    }
  ],
  "presets": [
    {
      "name": "24/SIE7E hero"
    }
  ]
}
{% endschema %}
